rules_version = '2';

// TrueNorth security rules.
//
// Access model, in three sentences:
//
//   1. Accounts are created by the administrator, never by self-registration.
//      The app has no sign-up screen; Firebase Authentication is the roster.
//   2. Having an account grants nothing. A person sees a company only once
//      somebody already inside it invites their address and they redeem it.
//   3. Once inside, members are trusted peers: they create their own projects
//      and decide for themselves who else to share a project or the company
//      with. Sharing is their call, not an administrator's.
//
//   4. What a member sees of Notion is decided by the role they have on.
//      A role names the Notion sources it reads; a task or project synced
//      from a source is readable only while the caller's active role reads
//      that source — and, for a source the role reads "assigned only", only
//      while the record names the caller. App-native records keep the
//      project visibility above.
//
// Nothing under a company is readable without a membership document inside it,
// so an account with no invitation sees an empty app and nothing else.
//
// The daily engine runs with the Admin SDK and bypasses these rules entirely,
// so the private-project filter is duplicated in the capture step, with its own
// tests.

service cloud.firestore {
  match /databases/{database}/documents {

    // The people allowed to create a company from scratch. Everyone else is
    // invited into one. Keep this list short and deliberate.
    function founders() {
      return ['sergio@aditumcr.com'];
    }

    function signedIn() {
      return request.auth != null;
    }

    // Lowercased: Firebase preserves whatever case was typed at sign-up, and a
    // founder list that only matches one casing is a trap.
    function email() {
      return request.auth.token.email.lower();
    }

    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function isFounder() {
      return signedIn() && email() in founders();
    }

    function membershipPath(companyId) {
      return /databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid);
    }

    function isMember(companyId) {
      return signedIn() && exists(membershipPath(companyId));
    }

    function access(companyId) {
      return get(membershipPath(companyId)).data.access;
    }

    function isAdmin(companyId) {
      return isMember(companyId) && access(companyId) in ['owner', 'admin'];
    }

    function isOwner(companyId) {
      return isMember(companyId) && access(companyId) == 'owner';
    }

    function isCreator(companyId) {
      return signedIn()
             && get(/databases/$(database)/documents/companies/$(companyId)).data.createdBy
                == request.auth.uid;
    }

    function invitePath() {
      return /databases/$(database)/documents/invites/$(email());
    }

    // A pending invitation for this exact address, into this exact company.
    // Verification matters: with email and password anyone can *claim* an
    // address at sign-up, so an unverified account must not redeem an invite.
    function invitedTo(companyId) {
      return verified()
             && exists(invitePath())
             && get(invitePath()).data.companyId == companyId;
    }

    // Only the listed fields changed, and nothing else.
    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    /* ---------------------------------------------------------------- */
    /* Roles and Notion sources                                          */
    /* ---------------------------------------------------------------- */

    // The caller's own member document. Firestore deduplicates identical
    // get() calls within one evaluation, so reading it here as well as in
    // access() costs nothing extra.
    function me(companyId) {
      return get(membershipPath(companyId)).data;
    }

    function activeRoleId(companyId) {
      return me(companyId).get('activeRoleId', null);
    }

    function activeRole(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId)/roles/$(activeRoleId(companyId))).data;
    }

    // The Notion sources the caller's active role reads. No active role, no
    // Notion: a person between roles sees app records only.
    function activeSourceIds(companyId) {
      return activeRoleId(companyId) == null ? [] : activeRole(companyId).get('sourceIds', []);
    }

    // Among those, the sources the role reads only through the caller's own
    // assignments (ADR-009). A role written before the field existed reads
    // everything, which is what it always did.
    function activeAssignedOnlyIds(companyId) {
      return activeRoleId(companyId) == null
             ? []
             : activeRole(companyId).get('assignedOnlySourceIds', []);
    }

    // A synced record is readable while its source is on the active role and,
    // when the role reads that source assigned-only, while the record names
    // the caller. `people` is the record's own array — `assigneeUserIds` on a
    // task, `memberUserIds` on a project — passed raw rather than through
    // get(), because that is what the query evaluator can prove against an
    // array-contains clause. `source` and `sourceId` are fixed by equality in
    // every query the app issues, so each list can be proven.
    function readsSource(companyId, people) {
      return resource.data.source == 'notion'
             && resource.data.sourceId in activeSourceIds(companyId)
             && (!(resource.data.sourceId in activeAssignedOnlyIds(companyId))
                 || request.auth.uid in people);
    }

    function isAppRecord() {
      return resource.data.source == 'app';
    }

    // A pull request is readable while its repository is on the caller's
    // active role — repositories share the role's `sourceIds` list with the
    // Notion databases (ADR-010) — and, when the role reads that repository
    // assigned-only, while the pull request names the caller as its author
    // or a reviewer. `people` is the record's own `peopleUserIds`, passed raw
    // for the same reason as in readsSource.
    function readsRepo(companyId, people) {
      return resource.data.repoId in activeSourceIds(companyId)
             && (!(resource.data.repoId in activeAssignedOnlyIds(companyId))
                 || request.auth.uid in people);
    }

    /* ---------------------------------------------------------------- */
    /* Invitations — top level, keyed by email address                   */
    /* ---------------------------------------------------------------- */

    // Top level rather than nested under the company, so an invited person can
    // read their own invitation and discover which company it belongs to
    // without needing to read the company itself first.
    match /invites/{invitedEmail} {
      allow get: if signedIn() && email() == invitedEmail;
      allow list: if false;

      // Any member may invite somebody into a company they belong to: sharing
      // is the members' decision. What they cannot do is create the account on
      // the other end — only the administrator does that.
      allow create: if isMember(request.resource.data.companyId)
                    && request.resource.data.email == invitedEmail
                    && request.resource.data.invitedBy == request.auth.uid
                    // Nobody grants more access than they hold themselves.
                    && (request.resource.data.access == 'member'
                        || isAdmin(request.resource.data.companyId));
      allow update: if isAdmin(resource.data.companyId);
      // Whoever sent it, an admin, or the person who just redeemed it.
      allow delete: if isAdmin(resource.data.companyId)
                    || resource.data.invitedBy == request.auth.uid
                    || (signedIn() && email() == invitedEmail);
    }

    /* ---------------------------------------------------------------- */
    /* Users                                                             */
    /* ---------------------------------------------------------------- */

    match /users/{uid} {
      // A person reads and writes only their own profile. Display name, locale,
      // theme, notify hour and FCM tokens all live here.
      allow read, write: if signedIn() && request.auth.uid == uid;

      // Mirror of the companies this person belongs to, so the app can list
      // them at sign-in without a collection-group query. Written by a trigger.
      match /memberships/{companyId} {
        allow read: if signedIn() && request.auth.uid == uid;
        // Written by the client on join; a trigger takes this over once Cloud
        // Functions exist. Guarded by actually being a member of that company.
        allow write: if signedIn() && request.auth.uid == uid && isMember(companyId);
      }
    }

    /* ---------------------------------------------------------------- */
    /* Companies                                                         */
    /* ---------------------------------------------------------------- */

    match /companies/{companyId} {
      allow read: if isMember(companyId);
      // The north star and the 3/6/12-month plans are company-wide direction,
      // so only an admin edits them.
      allow update: if isAdmin(companyId);
      allow create: if isFounder()
                    && request.resource.data.createdBy == request.auth.uid;
      allow delete: if isOwner(companyId);

      // Carries the person's display name and initials as well as their role,
      // because a member may not read anyone else's users/{uid} document.
      match /members/{memberUid} {
        allow read: if isMember(companyId);
        // A person may edit their own responsibility text and switch the role
        // they have on — only to one of their own; an admin may edit anyone's
        // roles, access level and expectations.
        allow update: if isAdmin(companyId)
                      || (request.auth.uid == memberUid
                          && changedOnly(['roleDescription']))
                      || (request.auth.uid == memberUid
                          && changedOnly(['activeRoleId'])
                          && request.resource.data.activeRoleId in resource.data.get('roleIds', []));
        // Three ways a member document comes into being:
        //   - an admin adds somebody — including a person with no account at
        //     all, under a synthetic id (`p_…`) that matches no uid and so
        //     grants nothing; they are on the team to be followed up with,
        //   - the founder who just created the company adds themselves, which
        //     no admin could do because being an admin needs this document,
        //   - an invited person redeems their invitation.
        allow create: if isAdmin(companyId)
                      || (request.auth.uid == memberUid && isCreator(companyId))
                      || (request.auth.uid == memberUid && invitedTo(companyId));
        allow delete: if isAdmin(companyId);
      }

      match /objectives/{objectiveId} {
        allow read: if isMember(companyId);
        allow write: if isMember(companyId);
      }

      // Roles: what the company calls its jobs, and which Notion sources each
      // reads. Everybody may see the list; admins shape it.
      match /roles/{roleId} {
        allow read: if isMember(companyId);
        allow write: if isAdmin(companyId);
      }

      // Rules are not filters. A rule that inspects resource.data rejects any
      // query it cannot prove safe in advance, so the branches below are
      // written to match the queries the app actually issues:
      //
      //   where('source', '==', 'app').where('visibility', '==', 'company')
      //   where('source', '==', 'app').where('memberUserIds', 'array-contains', uid)
      //   where('source', '==', 'notion').where('sourceId', '==', <id>)
      //                                       one per source the active role reads whole
      //   where('source', '==', 'notion').where('sourceId', '==', <id>)
      //       .where('memberUserIds', 'array-contains', uid)
      //                                       one per source it reads assigned-only
      //
      // Anything else, including an unfiltered listener on the collection, is
      // refused outright — which is correct, and is what the tests pin down.
      // A synced project is written with visibility 'company' for the type's
      // sake only: for it, the source *is* the visibility.
      match /projects/{projectId} {
        allow read: if isMember(companyId)
                    && ((isAppRecord()
                         && (resource.data.visibility == 'company'
                             || request.auth.uid in resource.data.memberUserIds))
                        || readsSource(companyId, resource.data.memberUserIds));
        allow create: if isMember(companyId) && request.resource.data.source == 'app';
        allow update, delete: if isMember(companyId)
                              && isAppRecord()
                              && (resource.data.visibility == 'company'
                                  || request.auth.uid in resource.data.memberUserIds);
      }

      // Three queries: where('source', '==', 'app'); per source the active
      // role reads whole, where('source', '==', 'notion').where('sourceId', '==', <id>);
      // and per source it reads assigned-only, the same with
      // .where('assigneeUserIds', 'array-contains', uid) added.
      // A task that came from Notion is edited in Notion; the browser only
      // ever writes app tasks.
      match /tasks/{taskId} {
        allow read: if isMember(companyId)
                    && (isAppRecord() || readsSource(companyId, resource.data.assigneeUserIds));
        allow create: if isMember(companyId) && request.resource.data.source == 'app';
        allow update, delete: if isMember(companyId) && isAppRecord();
      }

      match /risks/{riskId} {
        allow read, write: if isMember(companyId);
      }

      // What is going on with a person that the numbers do not show. These are
      // private notes about identifiable people, written so the follow-up can
      // be kind rather than mechanical, and the person they describe is not
      // meant to read them — so admins only, not every member.
      match /situations/{situationId} {
        allow read, write: if isAdmin(companyId);
      }

      // The Notion connection holds the workspace name and the last sync,
      // never a token, but it still stays with the admins.
      match /integrations/{provider} {
        allow read: if isMember(companyId);
        allow write: if isAdmin(companyId);
      }

      // A registered Notion database and its mapping. The assignment of who
      // reads it lives on the roles, so the list itself is plain metadata.
      match /notionSources/{sourceId} {
        allow read: if isMember(companyId);
        allow write: if isAdmin(companyId);
      }

      // A registered GitHub repository and the project it belongs to. Who
      // reads its pull requests lives on the roles, like a Notion source.
      match /githubRepos/{repoId} {
        allow read: if isMember(companyId);
        allow write: if isAdmin(companyId);
      }

      // Two queries, one per repository the active role reads:
      //   where('repoId', '==', <id>)                                          read whole
      //   where('repoId', '==', <id>).where('peopleUserIds', 'array-contains', uid)  assigned-only
      // Written by the sync only; the browser never edits a pull request.
      match /pullRequests/{pullId} {
        allow read: if isMember(companyId) && readsRepo(companyId, resource.data.peopleUserIds);
        allow write: if false;
      }

      // Briefings and plans are written by the engine only, one per person
      // and role. A person reads their own, and may only add feedback to a
      // plan.
      match /analyses/{analysisId} {
        allow read: if isMember(companyId) && resource.data.uid == request.auth.uid;
        allow write: if false;
      }

      match /plans/{planId} {
        allow read: if isMember(companyId) && resource.data.uid == request.auth.uid;
        allow update: if isMember(companyId)
                      && resource.data.uid == request.auth.uid
                      && changedOnly(['feedback', 'stale']);
        // Only the engine writes a plan. A plan a person could create for
        // themselves would look exactly like a real one, and the point of the
        // screen is that it never lies about whether the engine ran.
        allow create, delete: if false;
      }

      // The team follow-up: one document per manager per day, written by the
      // engine. A manager reads only their own — the readings quote signals
      // about other people, and the messages were written for them to send.
      // All they may write back is what they did with each one.
      match /followups/{followUpId} {
        allow read: if isMember(companyId)
                    && resource.data.managerUid == request.auth.uid;
        allow update: if isMember(companyId)
                      && resource.data.managerUid == request.auth.uid
                      && changedOnly(['outcome', 'sentText']);
        allow create, delete: if false;
      }

      // Dictated updates: a person creates and edits their own until it is
      // applied. The engine and the Notion writer take it from there.
      match /updates/{updateId} {
        allow read: if isMember(companyId) && resource.data.uid == request.auth.uid;
        allow create: if isMember(companyId)
                      && request.resource.data.uid == request.auth.uid;
        allow update: if isMember(companyId)
                      && resource.data.uid == request.auth.uid
                      && resource.data.appliedAt == null;
        allow delete: if false;
      }
    }

    /* ---------------------------------------------------------------- */
    /* Engine plumbing — server only                                     */
    /* ---------------------------------------------------------------- */

    // Engine run log and the server heartbeat, both written by the Pi with the
    // Admin SDK. Members may read the heartbeat so the app can say whether the
    // engine is up and when it last ran. (`jobs` is kept closed rather than
    // removed; ADR-005 dropped the queue it was for.)
    match /jobs/{jobId} {
      allow read, write: if false;
    }

    match /workers/{workerId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Outbound email queue for the Trigger Email extension.
    match /mail/{docId} {
      allow read, write: if false;
    }

    // Anything not matched above is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
