{
  "name": "truenorth",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @truenorth/web dev",
    "build": "pnpm --filter @truenorth/web build",
    "start": "pnpm --filter @truenorth/web start",
    "lint": "pnpm --filter @truenorth/web lint",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "test": "pnpm --filter @truenorth/core test"
  },
