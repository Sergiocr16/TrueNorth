# ---------------------------------------------------------------------------
# Firebase web configuration.
#
# These values are PUBLIC by design: they ship inside the JavaScript bundle
# that every visitor downloads. What protects the data is firestore.rules, not
# secrecy here. Copy this file to .env.local and paste the values from
# Firebase console > Project settings > Your apps > Web app > SDK setup.
#
# NEVER put a service-account JSON here. That file (the one containing
# "private_key") bypasses all security rules and belongs in Secret Manager and
# on the Raspberry Pi only.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Web Push. Firebase console > Project settings > Cloud Messaging >
# Web configuration > Web Push certificates > key pair.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Point the app at the local emulators instead of the real project.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# ---------------------------------------------------------------------------
# Engine (server only). On the Pi these live in /etc/truenorth/env.
# ---------------------------------------------------------------------------
# Service-account key for the Admin SDK. NEVER commit the file it points at.
GOOGLE_APPLICATION_CREDENTIALS=/etc/truenorth/service-account.json
# Shared secret the systemd timer sends to POST /api/engine/daily.
ENGINE_LOCAL_TOKEN=
# subscription (default: the signed-in claude session) or api_key.
ENGINE_AUTH=subscription
ANTHROPIC_API_KEY=
# The model the engine uses. Pin it: left empty, the CLI picks one on its own
# and the daily plan quietly changes character from one day to the next.
ENGINE_MODEL=claude-opus-5
# Optional: path to the claude binary if it is not on PATH.
CLAUDE_BIN=
WORKER_ID=pi-01
# Optional: empty directory Claude Code runs in (default: <tmp>/truenorth-engine).
ENGINE_WORKDIR=

# ---------------------------------------------------------------------------
# Integrations (server only). Databases and repositories are registered from
# the app; only the tokens live here.
# ---------------------------------------------------------------------------
# Notion internal integration secret (notion.so/my-integrations).
NOTION_TOKEN=
# GitHub personal access token with read access to pull requests, contents
# and metadata on the repositories to read. `gh auth token` on a logged-in
# machine gives one.
GITHUB_TOKEN=
