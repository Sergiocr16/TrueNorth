rules_version = '2';

// Voice recordings only. A person writes their own audio under their own uid
// and nobody reads it back from the client: the transcription runs server-side
// and the result lands in Firestore.
service firebase.storage {
  match /b/{bucket}/o {
    // Company logos. Written only by the server, through
    // /api/company/logo, which verifies the ID token and checks membership
    // with the Admin SDK. The browser never touches this folder: the rule
    // that used to authorise it had to read Firestore, and that cross-service
    // check needs an IAM grant the CLI does not create, so it failed closed.
    // Reading happens through the download-token URL the route hands back,
    // which authenticates with the token rather than with these rules.
    match /logos/{companyId}/{fileName} {
      allow read, write: if false;
    }

    match /voice/{companyId}/{uid}/{fileName} {
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 25 * 1024 * 1024
                   && request.resource.contentType.matches('audio/.*');
      allow read: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
