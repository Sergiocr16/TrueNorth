{
  "indexes": [
    {
      "comment": "Today and Risks: a person's open tasks, soonest deadline first.",
      "collectionGroup": "tasks",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "assigneeUserId", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "dueDate", "order": "ASCENDING" }
      ]
    },
    {
      "comment": "Risks: every overdue task in the company.",
      "collectionGroup": "tasks",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "dueDate", "order": "ASCENDING" }
      ]
    },
    {
      "comment": "Project detail: tasks of one project grouped by status.",
      "collectionGroup": "tasks",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "projectId", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "dueDate", "order": "ASCENDING" }
      ]
    },
    {
      "comment": "Notion sync: pages edited since the last run.",
      "collectionGroup": "tasks",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "source", "order": "ASCENDING" },
        { "fieldPath": "syncedAt", "order": "ASCENDING" }
      ]
    },
    {
      "comment": "Briefing history: my own plans, newest first.",
      "collectionGroup": "plans",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "uid", "order": "ASCENDING" },
        { "fieldPath": "date", "order": "DESCENDING" }
      ]
    },
    {
      "comment": "Briefing history: my own briefings, newest first.",
      "collectionGroup": "analyses",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "uid", "order": "ASCENDING" },
        { "fieldPath": "date", "order": "DESCENDING" }
      ]
    },
    {
      "comment": "Pull requests of one repository, only those naming the caller (assigned-only role).",
      "collectionGroup": "pullRequests",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "repoId", "order": "ASCENDING" },
        { "fieldPath": "peopleUserIds", "arrayConfig": "CONTAINS" }
      ]
    },
    {
      "comment": "Worker: the next queued job, oldest first.",
      "collectionGroup": "jobs",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "scheduledFor", "order": "ASCENDING" }
      ]
    }
  ],
  "fieldOverrides": []
}
